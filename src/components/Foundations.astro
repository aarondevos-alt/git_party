---
import { getCollection } from "astro:content";
import FoundationsCard from "./FoundationsCard.astro";

const foundations = await getCollection("foundations");
---

<section class="container" id="foundations">
  <header>
    <h2><span>Our foundations</span></h2>
    <p>
      These foundations create an environment that encourages innovation,
      creativity, and personal growth.
    </p>
  </header>
  <ul>
    {
      foundations.map((foundation) => (
        <li>
          <FoundationsCard foundation={foundation} />
        </li>
      ))
    }
  </ul>
</section>

<script>
  console.log(
    "🔍 Psst... foundations hide more than you think. Click the title 3 times.",
  );

  const title = document.querySelector("#foundations h2 span");
  let clicks = 0;

  title?.addEventListener("click", () => {
    clicks++;
    if (clicks === 3) {
      title.textContent = "Our foundation: 7";
      console.log("Digit #2 of the code = 7");
    }
  });
</script>

<style>
  h2 {
    white-space: nowrap;
  }

  ul {
    counter-reset: counter;
  }
</style>
