---

<form class="code-form">
  <label for="digit-1" class="visually-hidden">Digit 1</label>
  <input id="digit-1" type="text" inputmode="numeric" maxlength="1" required />

  <label for="digit-2" class="visually-hidden">Digit 2</label>
  <input id="digit-2" type="text" inputmode="numeric" maxlength="1" required />

  <label for="digit-3" class="visually-hidden">Digit 3</label>
  <input id="digit-3" type="text" inputmode="numeric" maxlength="1" required />

  <label for="digit-4" class="visually-hidden">Digit 4</label>
  <input id="digit-4" type="text" inputmode="numeric" maxlength="1" required />

  <button type="submit">Check code</button>
</form>

<p class="code-result" aria-live="polite"></p>

<script>
  const SECRET = "6767"; // 👈 hier staat jullie code

  const form = document.querySelector(".code-form");
  const inputs = [...document.querySelectorAll(".code-form input")];
  const result = document.querySelector(".code-result");

  // automatisch naar het volgende vakje springen
  inputs.forEach((input, i) => {
    input.addEventListener("input", () => {
      if (input.value && inputs[i + 1]) inputs[i + 1].focus();
    });
  });

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const entered = inputs.map((input) => input.value).join("");

    if (entered === SECRET) {
      result.textContent = "🎉 Correct! You cracked the code!";
    } else {
      result.textContent = "❌ Wrong code, keep searching...";
    }
  });
</script>

<style>
  .code-form {
    display: flex;
    gap: var(--sp-m);
    align-items: center;
  }

  input {
    width: 3rem;
    height: 3.5rem;
    font-size: 2rem;
    text-align: center;
    border: 2px solid var(--color-text);
    border-radius: var(--br-l);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
</style>
