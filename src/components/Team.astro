---
import { getCollection } from "astro:content";
import TeamCard from "./TeamCard.astro";
const team = await getCollection("team");
---

<svg
  viewBox="0 0 98 99"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  width="0"
  height="0"
>
  <g fill="none">
    <defs>
      <clipPath
        id="petals"
        clipPathUnits="objectBoundingBox"
        transform="scale(0.01, 0.01)"
      >
        <path
          d="M83.8068 49.7349C116.649 87.1445 86.3213 117.472 48.9117 84.63C11.5021 117.472 -18.8258 87.1445 14.0166 49.7349C-18.8258 12.3253 11.5021 -18.0026 48.9117 14.8398C86.3213 -18.0026 116.649 12.3253 83.8068 49.7349Z"
          fill="#231F20"></path>
      </clipPath>
    </defs>
  </g>
</svg>

<section class="container" id="team">
  <header>
    <h2><span>Team</span></h2>
    <p>Check these superheroes</p>
    <button class="secret" type="button" aria-label="Geheim" title="Klik mij... vaak">
      <span class="secret__hint" aria-hidden="true">?</span>
      <span class="secret__number" aria-hidden="true">6</span>
    </button>
  </header>
  <ul>
    {
      team.map((member) => (
        <li>
          <TeamCard member={member} />
        </li>
      ))
    }
  </ul>
</section>

<style>
  ul {
    display: grid;
    gap: var(--sp-l);
    grid-template-columns: repeat(auto-fit, minmax(22rem, 1fr));
    margin-bottom: var(--sp-xl);
  }

  .secret {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-top: var(--sp-s, 0.5rem);
    padding: 0;
    border: 2px dashed currentColor;
    border-radius: 50%;
    background: none;
    color: inherit;
    font-size: 1.25rem;
    font-weight: bold;
    cursor: pointer;
    opacity: 0.5;
    animation: secretPulse 2s ease-in-out infinite;
    transition: opacity 0.3s, transform 0.15s;
  }

  .secret:hover {
    opacity: 1;
  }

  .secret:active {
    transform: scale(0.85);
  }

  .secret__hint,
  .secret__number {
    grid-area: 1 / 1;
    transition: opacity 0.6s;
  }

  .secret__number {
    opacity: 0;
  }

  .secret--found {
    border-style: solid;
    opacity: 1;
    animation: none;
  }

  .secret--found .secret__hint {
    opacity: 0;
  }

  .secret--found .secret__number {
    opacity: 1;
  }

  @keyframes secretPulse {
    50% {
      transform: scale(1.1);
    }
  }
</style>

<script>
  const secretButton = document.querySelector(".secret");
  let clickCount = 0;

  const handleSecretClick = () => {
    clickCount++;
    if (clickCount >= 6) {
      secretButton?.classList.add("secret--found");
    }
  };

  secretButton?.addEventListener("click", handleSecretClick);
</script>
