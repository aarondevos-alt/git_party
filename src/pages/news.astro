---
import Base from "../layouts/Base.astro";
import { getCollection, render } from "astro:content";

const news = (await getCollection("news")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const items = await Promise.all(
  news.map(async (item) => ({ item, Content: (await render(item)).Content })),
);
---

<Base title="News">
  <div class="container">
    <h2><span>News</span></h2>
    <p class="secret__hint">Psst… type the word <em>party</em>.</p>
    <p class="code secret__code" hidden>The fourth digit of the code is 7</p>
    <ul>
      {
        items.map(({ item, Content }) => (
          <li>
            <article>
              <h3>{item.data.title}</h3>
              <time datetime={item.data.date.toISOString().slice(0, 10)}>
                {item.data.date.toISOString().slice(0, 10)}
              </time>
              <div class="md">
                <Content />
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  ul > li:not(:last-child) {
    border-bottom: solid grey 1px;
    padding-bottom: var(--sp-l);
    margin-bottom: var(--sp-xl);
  }

  h3 {
    margin-bottom: var(--sp-2xs);
  }

  time {
    display: block;
    margin-bottom: var(--sp-l);
  }

  .secret__hint {
    opacity: 0.4;
    font-size: 0.8em;
  }

  .secret__code {
    animation: secretReveal 0.6s ease-out;
  }

  @keyframes secretReveal {
    from {
      opacity: 0;
      transform: scale(0.5) rotate(-10deg);
    }
  }
</style>

<script>
  const secretWord = "party";
  let typedKeys = "";

  const revealCode = () => {
    const code = document.querySelector<HTMLElement>(".secret__code");
    const hint = document.querySelector<HTMLElement>(".secret__hint");
    if (!code || !hint) return;
    code.hidden = false;
    hint.hidden = true;
  };

  const handleKeydown = (event: KeyboardEvent) => {
    typedKeys = (typedKeys + event.key.toLowerCase()).slice(-secretWord.length);
    if (typedKeys === secretWord) revealCode();
  };

  document.addEventListener("keydown", handleKeydown);
</script>
