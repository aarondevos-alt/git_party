---
import { getCollection, render } from "astro:content";
import Markdown from "../../layouts/Markdown.astro";

export async function getStaticPaths() {
  const workshops = await getCollection("workshops");

  return workshops.map((workshop) => ({
    params: { id: workshop.id },
    props: { workshop },
  }));
}

const { workshop } = Astro.props;
const { title, image } = workshop.data;
const { Content } = await render(workshop);
---

<Markdown>
  <div slot="top">
    <a href="/#workshops">Workshops</a>
    <h1><span>{title}</span></h1>
  </div>

  <Content />

  <div slot="sidebar">
    <img
      width="300"
      height="300"
      src={image.src}
      alt="workshop image"
      class="image"
    />
  </div>
</Markdown>

<script>
  const revealHiddenNumber = (event: Event) => {
    (event.currentTarget as HTMLElement).classList.add("hidden-number--revealed");
  };

  document.querySelectorAll(".hidden-number").forEach((number) => {
    number.addEventListener("mouseenter", revealHiddenNumber, { once: true });
  });
</script>

<style>
  a {
    display: block;
    margin-bottom: var(--sp-m);
  }
</style>
