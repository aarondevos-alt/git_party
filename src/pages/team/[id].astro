---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
    const team = await getCollection("team");
    return team.map((member) => ({
        params: { id: member.id },
        props: { member },
    }));
}

const { member } = Astro.props;
const { Content } = await render(member);
---

<Base title={member.data.name}>
    <article class="container team-member">
        <a class="team-member__back" href="/#team">← Back to team</a>

        <Image
            class="team-member__pic"
            src={member.data.pic}
            width={300}
            height={300}
            alt={`Profile pic of ${member.data.name}`}
        />

        <h1 class="team-member__name">{member.data.name}</h1>
        <p class="team-member__function">{member.data.function}</p>

        <div class="team-member__bio">
            <Content />
        </div>
    </article>
</Base>

<style>
    .team-member {
        display: flex;
        flex-flow: column;
        gap: var(--sp-m);
        margin-bottom: var(--sp-xl);
    }

    .team-member__pic {
        filter: grayscale(100%) brightness(110%);
        object-fit: cover;
        aspect-ratio: 1;
        border-radius: var(--br-l);
    }

    .team-member__name,
    .team-member__function {
        margin: 0;
    }

    .team-member__bio {
        padding-top: var(--sp-m);
        border-top: solid 1px var(--color-text);
    }
</style>
